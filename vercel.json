{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && bun install --frozen-lockfile && bun run build",
  "regions": ["lhr1"],
  "env": {
    "PYTHONPATH": "src"
  },
  "build": {
    "env": {
      "PYTHONPATH": "src"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
